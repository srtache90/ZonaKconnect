# Dominio público del VPS (sin https://)
DOMAIN=facturacion.tudominio.com
ACME_EMAIL=admin@tudominio.com

# Postgres
POSTGRES_DB=zona_k_facturacion
POSTGRES_USER=zona_k_app
POSTGRES_PASSWORD=CAMBIAR_password_fuerte_db

# JWT (mínimo 32 caracteres)
JWT_SECRET=CAMBIAR_jwt_secreto_largo_minimo_32_chars
JWT_TTL_SECONDS=28800
JWT_COOKIE_SECURE=true

# MinIO (reemplazo de S3 / LocalStack)
MINIO_ROOT_USER=zonakminio
MINIO_ROOT_PASSWORD=CAMBIAR_password_minio_fuerte
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=zonakminio
AWS_SECRET_ACCESS_KEY=CAMBIAR_password_minio_fuerte
AWS_S3_ENDPOINT_OVERRIDE=http://minio:9000
AWS_S3_INVOICE_DOCUMENTS_BUCKET=invoice-documents-bucket
AWS_S3_RECEIVED_INVOICES_BUCKET=received-invoices-bucket

# Correo (SMTP Google Workspace)
MAIL_DISPATCH_ENABLED=true
MAIL_RECEPTION_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-cuenta@tudominio.com
MAIL_PASSWORD=CAMBIAR_app_password_google
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM=facturacion@tudominio.com

# DIAN_NET — bootstrap de .pfx local (false en producción).
# El mock DIAN solo se usa si la sociedad tiene dian_ambiente=Mock.
DIAN_MOCK_ENABLED=false
DIAN_CERT_PASSWORD=CAMBIAR_password_certificado_p12
# Ruta del .p12 montada en el contenedor
DIAN_CERT_PATH=/certs/dian-certificate.p12
